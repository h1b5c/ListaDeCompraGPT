# TURSO Database Configuration
# 1. Create a free account at https://app.turso.cloud
# 2. Create a new database
# 3. Get the connection string from the Turso Dashboard
# 4. Add these environment variables to your Vercel project settings

VITE_DB_URL=libsql://your-project.turso.io
VITE_DB_AUTH_TOKEN=your-token-here